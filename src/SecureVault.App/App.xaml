<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SecureVault.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SecureVault.App"
    xmlns:helpers="using:SecureVault.App.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/ThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibleConverter" Invert="False" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToCollapsedConverter" Invert="True" />
            <helpers:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <helpers:BoolToPlayPauseGlyphConverter x:Key="BoolToPlayPauseGlyphConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
