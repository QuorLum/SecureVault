<UserControl
    x:Class="SecureVault.App.Views.VirtualizedFileGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <!-- Virtualized ItemsRepeater (E07) -->
        <ItemsRepeater x:Name="FileRepeater" ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="160" MinItemHeight="160" MinColumnSpacing="14" MinRowSpacing="14" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:FileItemViewModel">
                    <Border Background="{StaticResource AppCardBrush}" 
                            BorderBrush="{StaticResource AppBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="{StaticResource CardCornerRadius}" 
                            Padding="12"
                            DataContext="{x:Bind}"
                            Tag="{x:Bind}"
                            PointerEntered="OnItemPointerEntered"
                            PointerExited="OnItemPointerExited"
                            DoubleTapped="OnItemDoubleTapped"
                            RightTapped="OnItemRightTapped"
                            AutomationProperties.Name="{x:Bind FileName}">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open" Icon="OpenWith" Click="OnOpenClicked" Tag="{x:Bind}" FontWeight="SemiBold" />
                                <MenuFlyoutItem Text="Export to Disk" Icon="Download" Click="OnExportClicked" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="Make a Copy" Icon="Copy" Click="OnCopyClicked" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="Rename" Icon="Rename" Click="OnRenameClicked" Tag="{x:Bind}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Toggle Favorite" Icon="Favorite" Click="OnToggleFavoriteClicked" Tag="{x:Bind}" />
                                <MenuFlyoutItem Text="Delete" Icon="Delete" Foreground="#FB7185" Click="OnDeleteClicked" Tag="{x:Bind}" />
                            </MenuFlyout>
                        </Border.ContextFlyout>

                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Glyph Preview / Icon Area -->
                            <Border Background="#1C1C22" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="32" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Favorite Star Indicator -->
                            <Button HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Margin="4" 
                                    Padding="4" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Click="OnToggleFavoriteClicked" 
                                    ToolTipService.ToolTip="Toggle Favorite">
                                <FontIcon Glyph="&#xE735;" 
                                          FontSize="13" 
                                          Foreground="#F59E0B"
                                          Opacity="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}" />
                            </Button>

                            <!-- Filename -->
                            <TextBlock Grid.Row="1" 
                                       Text="{x:Bind FileName}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       TextTrimming="CharacterEllipsis" 
                                       MaxLines="1" />

                            <!-- Metadata row: Formatted Size and Category Badge -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                    <TextBlock Text="{x:Bind CategoryName}" FontSize="9" Foreground="#818CF8" FontWeight="Medium" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </ScrollViewer>
</UserControl>
