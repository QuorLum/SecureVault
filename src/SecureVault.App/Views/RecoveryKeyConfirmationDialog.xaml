<ContentDialog
    x:Class="SecureVault.App.Views.RecoveryKeyConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SecureVault — Recovery Key Verification"
    PrimaryButtonText="Continue to Verification >"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16" Width="520">
        <!-- ============================================================= -->
        <!-- STEP 1: DISPLAY & SECURE RECORDING (Words Visible)            -->
        <!-- ============================================================= -->
        <StackPanel x:Name="Step1Container" Spacing="16" Visibility="Visible">
            <Border Background="{StaticResource WarningBgBrush}" 
                    BorderBrush="{StaticResource WarningBrush}" 
                    BorderThickness="1" 
                    CornerRadius="{StaticResource CardCornerRadius}" 
                    Padding="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource WarningBrush}" FontSize="20" VerticalAlignment="Top" />
                    <TextBlock Text="Store these 24 words in a secure physical location. If you lose your password, this recovery phrase is the ONLY way to recover your vault." 
                               TextWrapping="Wrap" 
                               FontSize="12" 
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 24 Words Grid Display -->
            <Border Background="{StaticResource AppCardBrush}" 
                    BorderBrush="{StaticResource AppBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="{StaticResource CardCornerRadius}" 
                    Padding="14">
                <ItemsRepeater x:Name="WordsRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="110" MinColumnSpacing="8" MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1C21" BorderBrush="#2D2D35" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas, monospace" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <!-- Copy to Clipboard and Confirmation -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CopyWordsBtn" Click="OnCopyWordsClicked" Style="{StaticResource DefaultButtonStyle}" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="Copy All Words" FontSize="12" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CopyStatusText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource FastModeBrush}" Visibility="Collapsed" />
            </Grid>

            <CheckBox x:Name="AcknowledgeCheckBox" 
                      Content="I have written down or safely recorded these 24 words offline." 
                      FontSize="12" 
                      Checked="OnAcknowledgeChanged" 
                      Unchecked="OnAcknowledgeChanged" />
        </StackPanel>

        <!-- ============================================================= -->
        <!-- STEP 2: BLIND VERIFICATION (Words Completely Hidden)           -->
        <!-- ============================================================= -->
        <StackPanel x:Name="Step2Container" Spacing="16" Visibility="Collapsed">
            <Border Background="#131B2E" 
                    BorderBrush="#2563EB" 
                    BorderThickness="1" 
                    CornerRadius="{StaticResource CardCornerRadius}" 
                    Padding="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" Foreground="#38BDF8" FontSize="20" VerticalAlignment="Top" />
                    <TextBlock Text="Blind Verification: Confirm you have recorded your recovery phrase by typing the requested 3 words from your offline backup." 
                               TextWrapping="Wrap" 
                               FontSize="12" 
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Enter the requested words below:" 
                       FontSize="12" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="PromptWord1" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBox x:Name="InputWord1" PlaceholderText="Type word" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="PromptWord2" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBox x:Name="InputWord2" PlaceholderText="Type word" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock x:Name="PromptWord3" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBox x:Name="InputWord3" PlaceholderText="Type word" FontSize="12" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
