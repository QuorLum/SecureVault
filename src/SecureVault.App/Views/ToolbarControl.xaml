<UserControl
    x:Class="SecureVault.App.Views.ToolbarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d">

    <Grid Background="#101013" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Actions: Compact Add DropDown, Paste, and Tools Menu -->
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
            <!-- Unified + Add Action Menu -->
            <DropDownButton Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Add Content">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <TextBlock Text="Add" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Add Files..." Command="{x:Bind ViewModel.AddFilesCommand, Mode=OneWay}" Icon="OpenFile" />
                        <MenuFlyoutItem Text="Add Folder..." Command="{x:Bind ViewModel.AddFolderCommand, Mode=OneWay}" Icon="Folder" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="New Note" Command="{x:Bind ViewModel.CreateNewNoteCommand, Mode=OneWay}" Icon="Document" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- Paste from Clipboard -->
            <Button Command="{x:Bind ViewModel.PasteClipboardCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    ToolTipService.ToolTip="Paste from Clipboard (Ctrl+V)"
                    AutomationProperties.Name="Paste from Clipboard">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE77F;" FontSize="12" />
                    <TextBlock Text="Paste" FontSize="12" />
                </StackPanel>
            </Button>

            <!-- Secondary Management Tools DropDown -->
            <DropDownButton Style="{StaticResource DefaultButtonStyle}" ToolTipService.ToolTip="Vault Operations &amp; Maintenance">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEC7A;" FontSize="13" />
                    <TextBlock Text="Tools" FontSize="12" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="File Manager" Command="{x:Bind ViewModel.OpenFileManagerCommand, Mode=OneWay}" Icon="BrowsePhotos" />
                        <MenuFlyoutItem Text="Backup Vault..." Command="{x:Bind ViewModel.OpenBackupDialogCommand, Mode=OneWay}" Icon="Save" />
                        <MenuFlyoutItem Text="Vault Chain Health..." Command="{x:Bind ViewModel.OpenVaultChainHealthDialogCommand, Mode=OneWay}" Icon="Repair" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Compact &amp; Defragment" Command="{x:Bind ViewModel.OpenCompactionCommand, Mode=OneWay}" Icon="Trim" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <!-- Center: Responsive Search Box -->
        <AutoSuggestBox Grid.Column="1" 
                        HorizontalAlignment="Stretch"
                        MaxWidth="320" 
                        Margin="12,0" 
                        PlaceholderText="Search files, tags, notes..." 
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        QueryIcon="Find" 
                        VerticalAlignment="Center" 
                        TextChanged="OnSearchTextChanged" 
                        AutomationProperties.Name="Search Box" />

        <!-- Right: View Modes, Sort, Settings and Lock -->
        <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="2">
            <!-- View Mode Switcher -->
            <Button Command="{x:Bind ViewModel.ViewMode.SetGridModeCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Grid View" Padding="6,4" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE74C;" FontSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.ViewMode.SetDetailedListModeCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Detailed List View" Padding="6,4" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.ViewMode.SetTimelineModeCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Timeline View" Padding="6,4" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE787;" FontSize="14" />
            </Button>

            <ComboBox x:Name="SortCombo" SelectionChanged="OnSortSelectionChanged" SelectedIndex="0" Width="105" FontSize="12">
                <ComboBoxItem Content="Name" Tag="Name" />
                <ComboBoxItem Content="Date Added" Tag="DateAdded" />
                <ComboBoxItem Content="Date Mod" Tag="DateModified" />
                <ComboBoxItem Content="Size" Tag="Size" />
                <ComboBoxItem Content="Type" Tag="Type" />
            </ComboBox>

            <!-- Settings Button -->
            <Button Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Settings &amp; System Integration" Padding="6,4" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <!-- Lock Vault Button -->
            <Button Command="{x:Bind ViewModel.LockVaultCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Lock Vault (Scrub Keys)" 
                    Background="#271016" 
                    BorderBrush="#881337" 
                    Foreground="#FB7185" 
                    AutomationProperties.Name="Lock Vault">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="13" />
                    <TextBlock Text="Lock" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
