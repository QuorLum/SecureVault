<UserControl
    x:Class="SecureVault.App.Views.ToolbarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d">

    <Grid Background="#101013" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Actions: Add Operations -->
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
            <Button Content="+ Add Files" 
                    Command="{x:Bind ViewModel.AddFilesCommand, Mode=OneWay}" 
                    Style="{StaticResource AccentButtonStyle}" 
                    AutomationProperties.Name="Add Files" />
            
            <Button Content="+ Add Folder" 
                    Command="{x:Bind ViewModel.AddFolderCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    AutomationProperties.Name="Add Folder" />
        </StackPanel>

        <!-- Center: Search Box -->
        <AutoSuggestBox Grid.Column="1" 
                        MaxWidth="400" 
                        Margin="16,0" 
                        PlaceholderText="Search files, tags, notes..." 
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        QueryIcon="Find" 
                        VerticalAlignment="Center" 
                        TextChanged="OnSearchTextChanged" 
                        AutomationProperties.Name="Search Box" />

        <!-- Right: Sort and Lock -->
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="2">
            <ComboBox x:Name="SortCombo" SelectionChanged="OnSortSelectionChanged" SelectedIndex="0" Width="130" FontSize="12">
                <ComboBoxItem Content="Name" Tag="Name" />
                <ComboBoxItem Content="Date Added" Tag="DateAdded" />
                <ComboBoxItem Content="Date Modified" Tag="DateModified" />
                <ComboBoxItem Content="Size" Tag="Size" />
                <ComboBoxItem Content="Type" Tag="Type" />
            </ComboBox>

            <Button Command="{x:Bind ViewModel.LockVaultCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Lock Vault (Scrub Keys)" 
                    Background="#271016" 
                    BorderBrush="#881337" 
                    Foreground="#FB7185" 
                    AutomationProperties.Name="Lock Vault">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="13" />
                    <TextBlock Text="Lock" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
