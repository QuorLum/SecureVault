<UserControl
    x:Class="SecureVault.App.Views.ToolbarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d">

    <Grid Background="#101013" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Actions: Add Operations -->
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
            <Button Content="+ Add Files" 
                    Command="{x:Bind ViewModel.AddFilesCommand, Mode=OneWay}" 
                    Style="{StaticResource AccentButtonStyle}" 
                    AutomationProperties.Name="Add Files" />
            
            <Button Content="+ Add Folder" 
                    Command="{x:Bind ViewModel.AddFolderCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    AutomationProperties.Name="Add Folder" />

            <Button Content="+ Note" 
                    Command="{x:Bind ViewModel.CreateNewNoteCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    AutomationProperties.Name="Create Note" />

            <Button Content="File Manager" 
                    Command="{x:Bind ViewModel.OpenFileManagerCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    AutomationProperties.Name="File Manager" />

            <Button Content="Backup" 
                    Command="{x:Bind ViewModel.OpenBackupDialogCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    AutomationProperties.Name="Backup Vault" />

            <Button Content="Vault Chain" 
                    Command="{x:Bind ViewModel.OpenVaultChainHealthDialogCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    AutomationProperties.Name="Vault Chain Health" />

            <Button Content="Paste" 
                    Command="{x:Bind ViewModel.PasteClipboardCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    ToolTipService.ToolTip="Paste from Clipboard"
                    AutomationProperties.Name="Paste from Clipboard" />

            <Button Content="Compact" 
                    Command="{x:Bind ViewModel.OpenCompactionCommand, Mode=OneWay}" 
                    FontSize="12" 
                    CornerRadius="{StaticResource ButtonCornerRadius}" 
                    ToolTipService.ToolTip="Defragment and Compact Vault"
                    AutomationProperties.Name="Compact Vault" />
        </StackPanel>

        <!-- Center: Search Box -->
        <AutoSuggestBox Grid.Column="1" 
                        MaxWidth="400" 
                        Margin="16,0" 
                        PlaceholderText="Search files, tags, notes..." 
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        QueryIcon="Find" 
                        VerticalAlignment="Center" 
                        TextChanged="OnSearchTextChanged" 
                        AutomationProperties.Name="Search Box" />

        <!-- Right: View Modes, Sort, Settings and Lock -->
        <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="2">
            <!-- View Mode Switcher (D21) -->
            <Button Command="{x:Bind ViewModel.ViewMode.SetGridModeCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Grid View" Padding="6,4" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE74C;" FontSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.ViewMode.SetDetailedListModeCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Detailed List View" Padding="6,4" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.ViewMode.SetTimelineModeCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Timeline View" Padding="6,4" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE787;" FontSize="14" />
            </Button>

            <ComboBox x:Name="SortCombo" SelectionChanged="OnSortSelectionChanged" SelectedIndex="0" Width="120" FontSize="12">
                <ComboBoxItem Content="Name" Tag="Name" />
                <ComboBoxItem Content="Date Added" Tag="DateAdded" />
                <ComboBoxItem Content="Date Modified" Tag="DateModified" />
                <ComboBoxItem Content="Size" Tag="Size" />
                <ComboBoxItem Content="Type" Tag="Type" />
            </ComboBox>

            <!-- Settings Button -->
            <Button Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Settings &amp; Security" Padding="6,4" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <Button Command="{x:Bind ViewModel.LockVaultCommand, Mode=OneWay}" 
                    ToolTipService.ToolTip="Lock Vault (Scrub Keys)" 
                    Background="#271016" 
                    BorderBrush="#881337" 
                    Foreground="#FB7185" 
                    AutomationProperties.Name="Lock Vault">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="13" />
                    <TextBlock Text="Lock" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
