<Page
    x:Name="RootPage"
    x:Class="SecureVault.App.Views.FileManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    xmlns:format="using:SecureVault.Core.Format"
    mc:Ignorable="d"
    Background="#09090B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Actions Bar -->
        <Border Grid.Row="0" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Back & Current Path -->
                <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                    <Button Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Back" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="FILE MANAGER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#18181B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}" FontSize="12" FontFamily="Consolas, monospace" Foreground="{StaticResource AppAccentBrush}" />
                    </Border>
                    <Border Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{x:Bind ViewModel.TotalFolderSizeText, Mode=OneWay}" FontSize="11" Foreground="#818CF8" />
                    </Border>
                </StackPanel>

                <!-- Center: Status -->
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right: Encrypt Everything -->
                <Button Grid.Column="2" 
                        Content="Encrypt Everything (AES-256)" 
                        Command="{x:Bind ViewModel.EncryptEverythingCommand, Mode=OneWay}" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Padding="14,6" 
                        FontSize="12" />
            </Grid>
        </Border>

        <!-- Main Workspace Split View -->
        <Grid Grid.Row="1" Padding="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Storage Statistics & Folder Tree -->
            <Border Grid.Column="0" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="STORAGE STATISTICS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />
                        <ListView ItemsSource="{x:Bind ViewModel.CategoryStatistics, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryStat">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Count}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind FormattedSize}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <MenuFlyoutSeparator />

                        <TextBlock Text="VIRTUAL FOLDERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="#EAB308" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Files & Duplicate Finder -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <!-- Detailed File List Table -->
                <Border Grid.Row="0" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Grid Grid.Row="0" Padding="8,4" Background="#18181B" CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Category" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Size" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Protection" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="4" Text="Action" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CurrentFiles, Mode=OneWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileItemViewModel">
                                    <Grid Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Filename & Icon -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind FileName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{x:Bind CategoryName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        
                                        <!-- Protection Mode Tag -->
                                        <Border Grid.Column="3" Background="#18181B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ProtectionModeBadge}" FontSize="10" Foreground="#A1A1AA" />
                                        </Border>

                                        <!-- Actions (Toggle Mode or Extract Archive) -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                                            <Button Content="Toggle Mode" 
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.ToggleProtectionModeCommand}" 
                                                    CommandParameter="{x:Bind}" 
                                                    FontSize="10" 
                                                    Padding="6,3" />
                                            <Button Content="Unpack" 
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.ExtractArchiveCommand}" 
                                                    CommandParameter="{x:Bind}" 
                                                    FontSize="10" 
                                                    Padding="6,3" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Duplicate Files Finder (K08) -->
                <Border Grid.Row="1" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FB7185" />
                            <TextBlock Text="DUPLICATE FILE DETECTION (Identical SHA-256)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DuplicateGroup">
                                    <Border Background="#18181B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,3">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Hash}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{StaticResource TextTertiaryBrush}" />
                                            <ItemsControl ItemsSource="{x:Bind Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="format:IndexEntry">
                                                        <TextBlock Text="{x:Bind FileName}" FontSize="11" Foreground="#FB7185" Margin="8,1,0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
