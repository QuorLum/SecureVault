<ContentDialog
    x:Class="SecureVault.App.Views.CompactionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d"
    Title="Vault Defragmentation &amp; Compaction"
    CloseButtonText="Close"
    DefaultButton="None"
    CornerRadius="12"
    Background="#09090B">

    <Grid Width="500" Padding="12,16">
        <StackPanel Spacing="16">
            <TextBlock Text="Compaction defragments chunk storage on disk, reclaims orphaned space left by deleted or replaced files, and updates vault indices with two-phase rollback safety."
                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />

            <!-- Multi-Part Chain Disclaimer Notice -->
            <Border Background="#1C1917" BorderBrush="#78350F" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Center" />
                    <TextBlock Text="Notice: Compaction of vault chains over 200GB (multiple .vault files) is newer and less tested. Consider backing up before compacting a multi-part vault."
                               TextWrapping="Wrap" FontSize="11" Foreground="#FDE68A" />
                </StackPanel>
            </Border>

            <!-- Storage Analysis Card -->
            <Border Background="#141417" CornerRadius="8" Padding="16" BorderBrush="#27272A" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Current Container Size" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentSizeBytes, Mode=OneWay}" FontSize="12" FontWeight="Bold" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Estimated Reclaimable Space" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EstimatedReclaimableBytes, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Redundant Duplicate Copies" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DuplicateWastedBytes, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Progress & Status -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsCompacting, Mode=OneWay}">
                <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Height="6" CornerRadius="3" />
                <TextBlock Text="Compacting live chunks and updating master index..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Result Summary -->
            <Border Background="#064E3B" CornerRadius="6" Padding="12" Visibility="{x:Bind ViewModel.IsCompleted, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" FontSize="12" Foreground="#A7F3D0" TextWrapping="Wrap" />
            </Border>

            <!-- Error Message -->
            <Border Background="#7F1D1D" CornerRadius="6" Padding="12" 
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibleConverter}}">
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="12" Foreground="#FECACA" TextWrapping="Wrap" />
            </Border>

            <!-- Actions -->
            <Button Content="Start Compaction" 
                    Command="{x:Bind ViewModel.StartCompactionCommand}" 
                    IsEnabled="{x:Bind ViewModel.IsCompacting, Mode=OneWay, Converter={StaticResource BoolToInvertedConverter}}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" Height="36" />
        </StackPanel>
    </Grid>
</ContentDialog>
