<Page
    x:Class="SecureVault.App.Views.PdfViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d"
    Background="#09090B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Zoom Toolbar -->
        <Border Grid.Row="0" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Back & Title -->
                <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                    <Button Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Back" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="PDF" FontSize="10" Foreground="#818CF8" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Center: Page Navigation Controls -->
                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" HorizontalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.PreviousPageCommand, Mode=OneWay}" ToolTipService.ToolTip="Previous Page" Background="Transparent" BorderThickness="0" Padding="6">
                        <FontIcon Glyph="&#xE76B;" FontSize="13" />
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.PageIndicator, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Command="{x:Bind ViewModel.NextPageCommand, Mode=OneWay}" ToolTipService.ToolTip="Next Page" Background="Transparent" BorderThickness="0" Padding="6">
                        <FontIcon Glyph="&#xE76C;" FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- Right: Zoom & Search Controls -->
                <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="2">
                    <Button Command="{x:Bind ViewModel.ZoomOutCommand, Mode=OneWay}" ToolTipService.ToolTip="Zoom Out" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE71F;" FontSize="13" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ResetZoomCommand, Mode=OneWay}" ToolTipService.ToolTip="Reset Zoom" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="100%" FontSize="11" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ZoomInCommand, Mode=OneWay}" ToolTipService.ToolTip="Zoom In" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE71E;" FontSize="13" />
                    </Button>
                    <AppBarSeparator />
                    <ToggleButton IsChecked="{x:Bind ViewModel.IsSearchOpen, Mode=TwoWay}" ToolTipService.ToolTip="Find Text in PDF" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE721;" FontSize="13" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Bar Drawer -->
        <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,16,0" Width="360" Background="#18181B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Visibility="{x:Bind ViewModel.IsSearchOpen, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Canvas.ZIndex="10">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Find in document..." FontSize="12" />
                    <Button Grid.Column="1" Content="Find" Command="{x:Bind ViewModel.ExecuteSearchCommand, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Padding="12,5" FontSize="11" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.SearchResultsText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource AppAccentBrush}" />
            </StackPanel>
        </Border>

        <!-- Document Canvas Area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
            <Border Background="#FFFFFF" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top" 
                    CornerRadius="2" 
                    BorderThickness="1" 
                    BorderBrush="#27272A"
                    Margin="0,0,0,24">
                <Image Source="{x:Bind ViewModel.CurrentPageBitmap, Mode=OneWay}" 
                       Stretch="None" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
