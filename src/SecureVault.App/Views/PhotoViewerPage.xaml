<Page
    x:Class="SecureVault.App.Views.PhotoViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d"
    Background="#09090B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Top Floating HUD Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Back Button & Filename -->
                <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                    <Button Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Back" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.DimensionsText, Mode=OneWay}" FontSize="10" Foreground="#818CF8" />
                    </Border>
                </StackPanel>

                <!-- Center: Position Indicator -->
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PositionIndicator, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right: Zoom, Rotate, and EXIF Actions -->
                <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="2">
                    <Button Command="{x:Bind ViewModel.ZoomOutCommand, Mode=OneWay}" ToolTipService.ToolTip="Zoom Out (-)" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE71F;" FontSize="13" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ResetZoomCommand, Mode=OneWay}" ToolTipService.ToolTip="Fit to Screen" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="100%" FontSize="11" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ZoomInCommand, Mode=OneWay}" ToolTipService.ToolTip="Zoom In (+)" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE71E;" FontSize="13" />
                    </Button>
                    <AppBarSeparator />
                    <Button Command="{x:Bind ViewModel.RotateCounterClockwiseCommand, Mode=OneWay}" ToolTipService.ToolTip="Rotate 90° CCW" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.RotateClockwiseCommand, Mode=OneWay}" ToolTipService.ToolTip="Rotate 90° CW" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE7AD;" FontSize="13" />
                    </Button>
                    <AppBarSeparator />
                    <ToggleButton IsChecked="{x:Bind ViewModel.IsExifPanelOpen, Mode=TwoWay}" ToolTipService.ToolTip="Toggle EXIF Metadata" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE946;" FontSize="13" />
                    </ToggleButton>
                    <AppBarSeparator />
                    <Button Click="OnEditClicked" ToolTipService.ToolTip="Edit Photo (Crop, Flip)" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Photo Display Canvas -->
        <Grid Grid.Row="1" Grid.Column="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="5.0">
                <Image Source="{x:Bind ViewModel.DisplayImage, Mode=OneWay}" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />
            </ScrollViewer>

            <!-- Navigation Chevron Overlays -->
            <Button Command="{x:Bind ViewModel.PreviousPhotoCommand, Mode=OneWay}" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    Margin="16" 
                    Width="40" 
                    Height="40" 
                    CornerRadius="20" 
                    Background="#8009090B" 
                    BorderBrush="{StaticResource AppBorderBrush}" 
                    ToolTipService.ToolTip="Previous (Left Arrow)">
                <FontIcon Glyph="&#xE76B;" FontSize="14" />
            </Button>

            <Button Command="{x:Bind ViewModel.NextPhotoCommand, Mode=OneWay}" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Margin="16" 
                    Width="40" 
                    Height="40" 
                    CornerRadius="20" 
                    Background="#8009090B" 
                    BorderBrush="{StaticResource AppBorderBrush}" 
                    ToolTipService.ToolTip="Next (Right Arrow)">
                <FontIcon Glyph="&#xE76C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Right EXIF Metadata Panel -->
        <Border Grid.Row="1" Grid.Column="1" 
                Width="280" 
                Background="#0D0D10" 
                BorderBrush="{StaticResource AppBorderBrush}" 
                BorderThickness="1,0,0,0" 
                Padding="16" 
                Visibility="{x:Bind ViewModel.IsExifPanelOpen, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <TextBlock Text="PHOTO PROPERTIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="File Name" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="File Size" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Dimensions" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.DimensionsText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <TextBlock Text="CAMERA METADATA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Camera Model" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ExifData.CameraModel, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Date Taken" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ExifData.DateTaken, Mode=OneWay, TargetNullValue='N/A'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Aperture / Exposure" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ExifData.FNumber, Mode=OneWay, TargetNullValue='N/A'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="ISO" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ExifData.IsoSpeed, Mode=OneWay, TargetNullValue='N/A'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Focal Length" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ExifData.FocalLength, Mode=OneWay, TargetNullValue='N/A'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="GPS Location" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ExifData.GpsCoordinates, Mode=OneWay, TargetNullValue='No GPS data'}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
