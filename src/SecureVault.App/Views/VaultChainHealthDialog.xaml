<ContentDialog
    x:Class="SecureVault.App.Views.VaultChainHealthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    xmlns:mv="using:SecureVault.Core.MultiVault"
    mc:Ignorable="d"
    Title="Vault Chain Storage &amp; Health"
    CloseButtonText="Close"
    DefaultButton="Close"
    CornerRadius="12"
    Background="#09090B">

    <Grid Width="520" Height="420" Padding="4">
        <StackPanel Spacing="16">
            <!-- Metrics Summary Cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#18181B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Parts" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalPartsCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#18181B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Chain Size" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSizeFormatted, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#18181B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Per-Part Limit" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MaxPartSizeFormatted, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Warning Banner if Parts Missing -->
            <Border Background="#271016" BorderBrush="#881337" BorderThickness="1" CornerRadius="8" Padding="12"
                    Visibility="{x:Bind ViewModel.HasMissingParts, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" Foreground="#FB7185" FontSize="16" VerticalAlignment="Top" />
                    <TextBlock Text="{x:Bind ViewModel.MissingPartsWarning, Mode=OneWay}" 
                               Foreground="#FB7185" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Part Statuses List -->
            <StackPanel Spacing="6">
                <TextBlock Text="Vault Parts on Disk" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Background="#18181B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Height="220">
                    <ListView ItemsSource="{x:Bind ViewModel.PartStatuses, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="mv:VaultPartHealthStatus">
                                <Grid ColumnSpacing="12" Padding="10,8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Part Badge -->
                                    <Border Background="#2E1065" BorderBrush="#6B21A8" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind PartIndex}" FontSize="11" FontWeight="Bold" Foreground="#C084FC" />
                                    </Border>

                                    <!-- Filename and Path -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- File Size and Status -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind StatusMessage}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
