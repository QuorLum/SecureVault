<Page
    x:Class="SecureVault.App.Views.MediaPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d"
    Background="#050507">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#9009090B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Back" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Video Rendering Surface -->
        <Grid Grid.Row="1">
            <!-- LibVLC VideoView -->
            <vlc:VideoView x:Name="VlcVideoView" 
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch" 
                           Visibility="{x:Bind ViewModel.IsAudioOnly, Mode=OneWay, Converter={StaticResource BoolToCollapsedConverter}}" />

            <!-- Audio Waveform Visualizer Placeholder -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="16" 
                        Visibility="{x:Bind ViewModel.IsAudioOnly, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <Border Width="90" Height="90" CornerRadius="45" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="2" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8D6;" FontSize="40" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Hardware-Decrypted Streaming Audio" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Bottom Transport Controls Bar -->
        <Border Grid.Row="2" Background="#D009090B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Spacing="10">
                <!-- Seek Bar & Time Display -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider Value="{x:Bind ViewModel.Position, Mode=TwoWay}" 
                            Maximum="1.0" 
                            StepFrequency="0.001" 
                            ValueChanged="OnSeekSliderValueChanged" 
                            VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" 
                               Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" 
                               FontSize="11" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontFamily="Consolas, monospace" 
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Action Controls Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Play/Pause/Stop -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                        <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand, Mode=OneWay}" 
                                Width="36" 
                                Height="36" 
                                CornerRadius="18" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Padding="0">
                            <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToPlayPauseGlyphConverter}}" FontSize="14" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.StopCommand, Mode=OneWay}" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0" Padding="0">
                            <FontIcon Glyph="&#xE71A;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- Right: Volume, Speed, Fullscreen -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="2">
                        <!-- Volume -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.ToggleMuteCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="4">
                                <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                            <Slider Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" Width="90" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Speed ComboBox -->
                        <ComboBox x:Name="RateCombo" SelectionChanged="OnRateSelectionChanged" SelectedIndex="2" Width="80" FontSize="11" VerticalAlignment="Center">
                            <ComboBoxItem Content="0.5x" Tag="0.5" />
                            <ComboBoxItem Content="0.75x" Tag="0.75" />
                            <ComboBoxItem Content="1.0x" Tag="1.0" />
                            <ComboBoxItem Content="1.25x" Tag="1.25" />
                            <ComboBoxItem Content="1.5x" Tag="1.5" />
                            <ComboBoxItem Content="2.0x" Tag="2.0" />
                        </ComboBox>

                        <!-- Fullscreen -->
                        <Button Click="OnToggleFullscreenClicked" ToolTipService.ToolTip="Toggle Full Screen" Background="Transparent" BorderThickness="0" Padding="6">
                            <FontIcon Glyph="&#xE740;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
