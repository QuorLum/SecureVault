<ContentDialog
    x:Class="SecureVault.App.Views.FilePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d"
    Title="File Properties &amp; Cryptographic Inspection"
    CloseButtonText="Close"
    DefaultButton="None"
    CornerRadius="12"
    Background="#09090B">

    <Grid Width="600" Height="480">
        <TabView SelectedIndex="0" TabWidthMode="Equal">
            <!-- TAB 1: GENERAL -->
            <TabViewItem Header="General" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="12,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="File Name" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.FileName, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Virtual Path" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.VirtualPath, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Storage Location" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.PartLocation, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Original Size" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.FormattedOriginalSize, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Physical Stored Size" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.FormattedCompressedSize, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Date Added (UTC)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.DateAddedText, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Date Modified (UTC)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.DateModifiedText, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 2: CRYPTOGRAPHY -->
            <TabViewItem Header="Cryptography &amp; Hashes" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="12,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Protection Mode" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.ProtectionModeText, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="File UUID" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.FileGuidString, Mode=OneWay}" IsReadOnly="True" FontSize="12" FontFamily="Consolas" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Plaintext SHA-256 Checksum" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.PlaintextSha256Hex, Mode=OneWay}" IsReadOnly="True" FontSize="12" FontFamily="Consolas" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Total Chunks" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.ChunkCount, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="First Chunk Offset" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.FirstChunkOffsetHex, Mode=OneWay}" IsReadOnly="True" FontSize="12" FontFamily="Consolas" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 3: CHUNKS -->
            <TabViewItem Header="Chunk Table" IsClosable="False">
                <Grid Padding="12,8">
                    <ListView ItemsSource="{x:Bind ViewModel.Chunks, Mode=OneWay}" SelectionMode="None">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="40,90,70,80,130,80" Padding="8,4" Background="#141417" CornerRadius="4">
                                    <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="Size" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="CRC32" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="Auth Tag" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="RS Parity" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChunkDisplayItem">
                                <Grid ColumnDefinitions="40,90,70,80,130,80" Padding="8,4">
                                    <TextBlock Grid.Column="0" Text="{x:Bind Sequence}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind OffsetHex}" FontSize="11" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}" FontSize="11" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Crc32Hex}" FontSize="11" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind AuthTagHex}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ParityFormatted}" FontSize="11" Foreground="#10B981" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</ContentDialog>
