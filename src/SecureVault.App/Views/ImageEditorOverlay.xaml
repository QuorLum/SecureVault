<Page
    x:Class="SecureVault.App.Views.ImageEditorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d"
    Background="#09090B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Save Bar -->
        <Border Grid.Row="0" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                    <Button Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Cancel" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.DimensionsText, Mode=OneWay}" FontSize="10" Foreground="#818CF8" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button Grid.Column="2" 
                        Content="Save Changes" 
                        Command="{x:Bind ViewModel.SaveEditsCommand, Mode=OneWay}" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Padding="16,6" 
                        FontSize="12" />
            </Grid>
        </Border>

        <!-- Main Photo Preview Surface -->
        <Grid Grid.Row="1" Padding="24">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />
            </ScrollViewer>
        </Grid>

        <!-- Bottom Edit Tools Bar -->
        <Border Grid.Row="2" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Button Command="{x:Bind ViewModel.CropCenterCommand, Mode=OneWay}" Style="{StaticResource OutlineButtonStyle}" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A8;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="Crop Center (10%)" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.FlipHorizontalCommand, Mode=OneWay}" Style="{StaticResource OutlineButtonStyle}" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A9;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="Flip Horizontal" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.FlipVerticalCommand, Mode=OneWay}" Style="{StaticResource OutlineButtonStyle}" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7AA;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="Flip Vertical" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
