<UserControl
    x:Class="SecureVault.App.Views.StatusBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d">

    <Grid Background="#09090B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16" Grid.Column="0">
            <TextBlock Text="{x:Bind ViewModel.FileCountText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.VaultSizeText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.DiskFreeSpaceText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Right: Cryptographic Status -->
        <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="2">
            <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" />
            <TextBlock Text="AES-256-GCM Authenticated • Reed-Solomon Protected" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
