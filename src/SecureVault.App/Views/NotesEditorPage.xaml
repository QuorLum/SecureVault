<Page
    x:Class="SecureVault.App.Views.NotesEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SecureVault.App.ViewModels"
    mc:Ignorable="d"
    Background="#09090B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Action Toolbar -->
        <Border Grid.Row="0" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button & Editable Title -->
                <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                    <Button Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Back" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <TextBox Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14" 
                             FontWeight="Bold" 
                             Width="300" 
                             Background="Transparent" 
                             BorderThickness="0,0,0,1" 
                             BorderBrush="#3F3F46" 
                             VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Auto-Save Status Indicator -->
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right: Save & Toggle Preview -->
                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="2">
                    <Button Command="{x:Bind ViewModel.TogglePreviewCommand, Mode=OneWay}" ToolTipService.ToolTip="Toggle Markdown Preview" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                    </Button>

                    <Button Content="Save" 
                            Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Padding="14,6" 
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Editor & Preview Body -->
        <Grid Grid.Row="1" Padding="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Markdown Source Editor -->
            <Border Grid.Column="0" Background="#111114" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}" Padding="16">
                <TextBox Text="{x:Bind ViewModel.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         FontSize="13" 
                         FontFamily="Cascadia Code, Consolas, monospace" 
                         VerticalAlignment="Stretch" 
                         HorizontalAlignment="Stretch" />
            </Border>

            <!-- Column Splitter Separator -->
            <Border Grid.Column="1" Width="1" Background="{StaticResource AppBorderBrush}" Margin="12,0" 
                    Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" />

            <!-- Live Preview Pane -->
            <Border Grid.Column="2" 
                    Background="#111114" 
                    BorderBrush="{StaticResource AppBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="{StaticResource CardCornerRadius}" 
                    Padding="20"
                    Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{x:Bind ViewModel.Content, Mode=OneWay}" 
                                   TextWrapping="Wrap" 
                                   FontSize="13" 
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Word Count & Stats Bar -->
        <Border Grid.Row="2" Background="#09090B" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.WordCountText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="Markdown (AES-256-GCM Encrypted)" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
