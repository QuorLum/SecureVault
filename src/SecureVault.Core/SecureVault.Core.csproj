<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="STH1123.ReedSolomon" Version="2.1.0" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="Markdig" Version="0.44.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="SharpCompress" Version="0.40.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\english.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecureVault.Core.Tests" />
  </ItemGroup>

</Project>
